{
  "wifi": {
    "ssid": "your_wifi_ssid",
    "password": "your_wifi_password",
    "hostname": "ESP32-Sensor"
  },
  "mqtt": {
    "broker": "your.mqtt.broker",
    "user": "esp32",
    "password": "your-mqtt-password",
    "device_id": "ESP32-Sensor",
    "base_topic_root": "sensors/esp32",
  },
  "detector": {
    "type": "zscore",
    "zscore": {
      "window_size": 90,
      "threshold": 3
    },
    "ewma": {
      "alpha": 0.1,
      "threshold": 3,
      "min_samples": 5
    },
    "rulebased": {
      "temp": {
        "upper": 25,
        "lower": 16
      },
      "hum": {
        "upper": 60,
        "lower": 40
      }
    }
  }
}
